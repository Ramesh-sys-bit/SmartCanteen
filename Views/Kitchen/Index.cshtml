@model IEnumerable<SmartCanteen.Models.Order>

@{
    ViewData["Title"] = "Kitchen Dashboard";

    int placedCount = 0;
    int preparingCount = 0;
    int readyCount = 0;

    foreach (var currentOrder in Model)
    {
        if (currentOrder.Status == "Placed")
        {
            placedCount++;
        }
        else if (currentOrder.Status == "Preparing")
        {
            preparingCount++;
        }
        else if (currentOrder.Status == "Ready")
        {
            readyCount++;
        }
    }
}

<div class="container">

    <!-- Page Header -->

    <div class="text-center mb-4">

        <h1 class="fw-bold">
            👨‍🍳 Kitchen Dashboard
        </h1>

        <p class="text-muted">
            Manage incoming orders and update their preparation status.
        </p>

    </div>


    <!-- Summary Cards -->

    <div class="row g-4 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <div class="display-5 mb-2">
                        📥
                    </div>

                    <h6 class="text-muted">
                        Placed Orders
                    </h6>

                    <h2 class="fw-bold text-primary">
                        @placedCount
                    </h2>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <div class="display-5 mb-2">
                        👨‍🍳
                    </div>

                    <h6 class="text-muted">
                        Preparing Orders
                    </h6>

                    <h2 class="fw-bold text-warning">
                        @preparingCount
                    </h2>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <div class="display-5 mb-2">
                        ✅
                    </div>

                    <h6 class="text-muted">
                        Ready Orders
                    </h6>

                    <h2 class="fw-bold text-success">
                        @readyCount
                    </h2>

                </div>

            </div>

        </div>

    </div>


    <!-- Empty State -->

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center p-5">

                <div class="display-3 mb-3">
                    🍽️
                </div>

                <h4 class="fw-bold">
                    No Active Orders
                </h4>

                <p class="text-muted mb-0">
                    There are currently no orders waiting
                    for kitchen processing.
                </p>

            </div>

        </div>
    }
    else
    {
        <!-- Active Orders Header -->

        <div class="d-flex justify-content-between
                    align-items-center mb-3">

            <h3 class="fw-bold mb-0">
                Active Orders
            </h3>

            <span class="badge bg-primary fs-6">
                @Model.Count() Orders
            </span>

        </div>


        <!-- Orders -->

        <div class="row g-4">

            @foreach (var order in Model)
            {
                <div class="col-lg-6">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body p-4">

                            <!-- Order Header -->

                            <div class="d-flex justify-content-between
                                        align-items-start mb-3">

                                <div>

                                    <small class="text-muted">
                                        Order Token
                                    </small>

                                    <h2 class="fw-bold text-primary mb-0">
                                        #@order.TokenNo
                                    </h2>

                                </div>


                                <div>

                                    @if (order.Status == "Placed")
                                    {
                                        <span class="badge bg-primary fs-6 px-3 py-2">
                                            Placed
                                        </span>
                                    }
                                    else if (order.Status == "Preparing")
                                    {
                                        <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                            Preparing
                                        </span>
                                    }
                                    else if (order.Status == "Ready")
                                    {
                                        <span class="badge bg-success fs-6 px-3 py-2">
                                            Ready
                                        </span>
                                    }

                                </div>

                            </div>


                            <hr />


                            <!-- Student Details -->

                            <div class="row g-3 mb-3">

                                <div class="col-sm-6">

                                    <div class="bg-light rounded p-3">

                                        <small class="text-muted">
                                            Student
                                        </small>

                                        <div class="fw-bold">
                                            @order.Student?.Name
                                        </div>

                                    </div>

                                </div>


                                <div class="col-sm-6">

                                    <div class="bg-light rounded p-3">

                                        <small class="text-muted">
                                            Roll Number
                                        </small>

                                        <div class="fw-bold">
                                            @order.Student?.RollNo
                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- Items -->

                            <h5 class="fw-bold mb-3">
                                🍽️ Order Items
                            </h5>

                            <ul class="list-group mb-3">

                                @foreach (var item in order.Items)
                                {
                                    <li class="list-group-item
                                               d-flex justify-content-between
                                               align-items-center">

                                        <span>

                                            <strong>
                                                @item.MenuItem?.Name
                                            </strong>

                                        </span>

                                        <span class="badge bg-secondary">
                                            × @item.Quantity
                                        </span>

                                    </li>
                                }

                            </ul>


                            <!-- Order Information -->

                            <div class="row g-3 mb-4">

                                <div class="col-sm-6">

                                    <div class="border rounded p-3">

                                        <small class="text-muted">
                                            Total Amount
                                        </small>

                                        <div class="fw-bold text-success">
                                            ₹@order.TotalAmount.ToString("0.00")
                                        </div>

                                    </div>

                                </div>


                                <div class="col-sm-6">

                                    <div class="border rounded p-3">

                                        <small class="text-muted">
                                            Pickup Slot
                                        </small>

                                        <div class="fw-bold">

                                            @order.PickupSlot.ToString(
                                                "dd-MM-yyyy hh:mm tt")

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- Action -->

                            <div class="d-grid">

                                @if (order.Status == "Placed")
                                {
                                    <form asp-action="UpdateStatus"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@order.Id" />

                                        <input type="hidden"
                                               name="status"
                                               value="Preparing" />

                                        <button type="submit"
                                                class="btn btn-warning btn-lg w-100">

                                            👨‍🍳 Start Preparing

                                        </button>

                                    </form>
                                }

                                @if (order.Status == "Preparing")
                                {
                                    <form asp-action="UpdateStatus"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@order.Id" />

                                        <input type="hidden"
                                               name="status"
                                               value="Ready" />

                                        <button type="submit"
                                                class="btn btn-success btn-lg w-100">

                                            ✅ Mark Order Ready

                                        </button>

                                    </form>
                                }

                                @if (order.Status == "Ready")
                                {
                                    <form asp-action="UpdateStatus"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@order.Id" />

                                        <input type="hidden"
                                               name="status"
                                               value="Completed" />

                                        <button type="submit"
                                                class="btn btn-secondary btn-lg w-100">

                                            ✔️ Complete Order

                                        </button>

                                    </form>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>