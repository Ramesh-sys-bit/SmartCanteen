@model IEnumerable<SmartCanteen.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container">

    <!-- Page Header -->

    <div class="text-center mb-4">

        <h1 class="fw-bold">
            📋 My Orders
        </h1>

        <p class="text-muted">
            View and track all your SmartCanteen orders.
        </p>

    </div>


    <!-- Search Card -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h4 class="fw-bold mb-3">
                🔎 Find Your Orders
            </h4>

            <form asp-controller="Orders"
                  asp-action="MyOrders"
                  method="get">

                <div class="row g-3">

                    <div class="col-md-8">

                        <label class="form-label fw-semibold">
                            Student Roll Number
                        </label>

                        <input type="text"
                               name="rollNo"
                               value="@ViewBag.RollNo"
                               class="form-control form-control-lg"
                               placeholder="Enter your roll number"
                               required />

                    </div>


                    <div class="col-md-4 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100">

                            🔎 View My Orders

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Error Message -->

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger shadow-sm">

            <strong>⚠️ Error:</strong>
            @ViewBag.Error

        </div>
    }


    <!-- No Orders -->

    @if (ViewBag.RollNo != null && !Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm">

            <h5 class="fw-bold">
                📭 No Orders Found
            </h5>

            <p class="mb-0">
                No orders were found for roll number
                <strong>@ViewBag.RollNo</strong>.
            </p>

        </div>
    }


    <!-- Orders -->

    @if (Model.Any())
    {
        <div class="d-flex justify-content-between
                    align-items-center mb-3">

            <h3 class="fw-bold mb-0">
                Your Orders
            </h3>

            <span class="badge bg-primary fs-6">
                @Model.Count() Orders
            </span>

        </div>


        <div class="row g-4">

            @foreach (var order in Model)
            {
                <div class="col-md-6">

                    <div class="card h-100 border-0 shadow-sm">

                        <div class="card-body p-4">

                            <!-- Order Header -->

                            <div class="d-flex justify-content-between
                                        align-items-start mb-3">

                                <div>

                                    <p class="text-muted mb-1">
                                        Order Token
                                    </p>

                                    <h3 class="fw-bold text-primary mb-0">
                                        #@order.TokenNo
                                    </h3>

                                </div>


                                <div>

                                    @if (order.Status == "Placed")
                                    {
                                        <span class="badge bg-primary px-3 py-2">
                                            Placed
                                        </span>
                                    }
                                    else if (order.Status == "Preparing")
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2">
                                            Preparing
                                        </span>
                                    }
                                    else if (order.Status == "Ready")
                                    {
                                        <span class="badge bg-success px-3 py-2">
                                            Ready
                                        </span>
                                    }
                                    else if (order.Status == "Completed")
                                    {
                                        <span class="badge bg-secondary px-3 py-2">
                                            Completed
                                        </span>
                                    }

                                </div>

                            </div>


                            <hr />


                            <!-- Items -->

                            <h5 class="fw-bold mb-3">
                                🍽️ Ordered Items
                            </h5>

                            <ul class="list-group mb-3">

                                @foreach (var item in order.Items)
                                {
                                    <li class="list-group-item
                                               d-flex justify-content-between">

                                        <span>

                                            <strong>
                                                @item.MenuItem?.Name
                                            </strong>

                                        </span>

                                        <span class="text-muted">
                                            × @item.Quantity
                                        </span>

                                    </li>
                                }

                            </ul>


                            <!-- Order Information -->

                            <div class="row g-2 mb-3">

                                <div class="col-6">

                                    <div class="bg-light rounded p-3">

                                        <small class="text-muted">
                                            Total Amount
                                        </small>

                                        <div class="fw-bold text-success">
                                            ₹@order.TotalAmount.ToString("0.00")
                                        </div>

                                    </div>

                                </div>


                                <div class="col-6">

                                    <div class="bg-light rounded p-3">

                                        <small class="text-muted">
                                            Pickup Slot
                                        </small>

                                        <div class="fw-bold">

                                            @order.PickupSlot.ToString(
                                                "dd-MM-yyyy hh:mm tt")

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- Track Button -->

                            <a asp-controller="Orders"
                               asp-action="Track"
                               asp-route-id="@order.Id"
                               class="btn btn-primary w-100">

                                📦 Track Order

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }


    <!-- Back To Menu -->

    <div class="text-center mt-5 mb-4">

        <a asp-controller="Menu"
           asp-action="Index"
           class="btn btn-outline-secondary">

            🍽️ Back to Menu

        </a>

    </div>

</div>