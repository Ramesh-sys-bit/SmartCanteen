@model IEnumerable<SmartCanteen.Models.MenuItem>

@{
    ViewData["Title"] = "Menu";
}

<div class="container">

    <!-- Page Header -->

    <div class="text-center mb-5">

        <h1 class="fw-bold">
            🍽️ SmartCanteen Menu
        </h1>

        <p class="text-muted">
            Choose your favourite food and place your order
            in advance.
        </p>

    </div>


    <!-- Quick Actions -->

    <div class="d-flex justify-content-center flex-wrap gap-2 mb-4">

        <a asp-controller="Orders"
           asp-action="MyOrders"
           class="btn btn-outline-primary">

            📋 My Orders

        </a>

        <a asp-controller="Menu"
           asp-action="Manage"
           class="btn btn-outline-success">

            ⚙️ Manage Menu

        </a>

    </div>


    <!-- Menu Items -->

    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-sm-6 col-lg-4">

                <div class="card h-100 border-0 shadow-sm">

                    <div class="card-body d-flex flex-column p-4">

                        <div class="d-flex justify-content-between
                                    align-items-start mb-2">

                            <h4 class="card-title fw-bold mb-0">
                                @item.Name
                            </h4>

                            <span class="badge bg-success">
                                Available
                            </span>

                        </div>


                        <h4 class="text-primary fw-bold mt-2">

                            ₹@item.Price.ToString("0.00")

                        </h4>


                        <div class="mt-2 mb-3">

                            <p class="text-muted mb-1">

                                ⏱️ Preparation:
                                <strong>
                                    @item.PrepMinutes min
                                </strong>

                            </p>

                            <p class="text-muted mb-0">

                                📦 Stock:
                                <strong>
                                    @item.StockQty
                                </strong>

                            </p>

                        </div>


                        <hr />


                        <form asp-controller="Orders"
                              asp-action="Checkout"
                              method="get"
                              class="mt-auto">

                            <input type="hidden"
                                   name="menuItemId"
                                   value="@item.Id" />


                            <label class="form-label fw-semibold">

                                Quantity

                            </label>


                            <input type="number"
                                   name="quantity"
                                   value="1"
                                   min="1"
                                   max="@item.StockQty"
                                   class="form-control mb-3" />


                            <button type="submit"
                                    class="btn btn-primary w-100">

                                🛒 Add to Cart

                            </button>

                        </form>

                    </div>

                </div>

            </div>
        }

    </div>


    <!-- Empty Menu -->

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center mt-4">

            <h5>
                Menu Currently Unavailable
            </h5>

            <p class="mb-0">
                Please check again later.
            </p>

        </div>
    }

</div>